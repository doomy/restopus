extensions:
    restopus: Doomy\Restopus\DI\RestopusExtension

restopus:
    presenterNamespace: Doomy\Restopus\tests\Support\Presenter
    presentersDir: %rootDir%/tests/Support/Presenter

application:
    mapping:
        *: Doomy\Restopus\tests\Support\Presenter\*Presenter

services:
    # The authenticator is an application concern, so Restopus does not register one.
    # DummyAuthenticator accepts any access token and exists for this test suite only;
    # a real application registers its own AuthenticatorInterface implementation here.
    - Doomy\Security\Authenticator\DummyAuthenticator
